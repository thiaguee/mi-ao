{
  "name": "norway-ao",
  "productName": "Norway AO",
  "version": "1.0.0",
  "description": "Norway AO - cliente del juego",
  "main": "main.js",
  "private": true,
  "license": "AGPL-3.0",
  "author": "Norway AO",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "ar.norwayao.cliente",
    "productName": "Norway AO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../client",
        "to": "client"
      },
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!cuentas/**",
          "!logs/**",
          "!config.json",
          "!baneados.json"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icono.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Norway AO",
      "artifactName": "NorwayAO-Instalador.exe",
      "language": "3082"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
